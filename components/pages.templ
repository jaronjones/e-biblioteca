package components

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/jjones/e-biblioteca/internal/models"
	"github.com/jjones/e-biblioteca/internal/service/metadata"
)

templ SetupPage(errMsg string) {
	<div class="auth-card card">
		<h1>Welcome to e-biblioteca</h1>
		<p class="muted">Create your admin account to get started.</p>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<form method="post" action="/setup" class="form-stack">
			<label>Username<input class="input" name="username" required autocomplete="username"/></label>
			<label>Display name<input class="input" name="display_name" autocomplete="name"/></label>
			<label>Password<input class="input" type="password" name="password" required minlength="8" autocomplete="new-password"/></label>
			<button class="btn btn-primary" type="submit">Create admin</button>
		</form>
	</div>
}

templ LoginPage(errMsg string) {
	<div class="auth-card card">
		<h1>Sign in</h1>
		<p class="muted">Your personal digital library.</p>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<form method="post" action="/login" class="form-stack">
			<label>Username<input class="input" name="username" required autocomplete="username"/></label>
			<label>Password<input class="input" type="password" name="password" required autocomplete="current-password"/></label>
			<button class="btn btn-primary" type="submit">Sign in</button>
		</form>
	</div>
}

templ DashboardPage(d models.DashboardData) {
	<div class="page">
		<header class="page-header">
			<div>
				<h1>Dashboard</h1>
				<p class="muted">Pick up where you left off.</p>
			</div>
		</header>
		<div class="stats-row">
			<div class="stat card"><div class="stat-label">Books</div><div class="stat-value">{ fmt.Sprintf("%d", d.BookCount) }</div></div>
			<div class="stat card"><div class="stat-label">Libraries</div><div class="stat-value">{ fmt.Sprintf("%d", d.LibraryCount) }</div></div>
			<div class="stat card"><div class="stat-label">BookDrop ready</div><div class="stat-value">{ fmt.Sprintf("%d", d.BookdropReady) }</div></div>
		</div>
		if len(d.InProgress) > 0 {
			<section class="section">
				<h2>Continue reading</h2>
				@BookGrid(d.InProgress)
			</section>
		}
		<section class="section">
			<h2>Recently added</h2>
			if len(d.RecentlyAdded) == 0 {
				<div class="empty card">
					<p>No books yet. Create a library and scan, or upload a file.</p>
					<a class="btn btn-primary" href="/libraries">Set up a library</a>
				</div>
			} else {
				@BookGrid(d.RecentlyAdded)
			}
		</section>
	</div>
}

templ BooksPage(books []models.Book, libs []models.Library, q, format string, libID int64, page, pages, total int) {
	<div class="page">
		<header class="page-header">
			<div>
				<h1>Books</h1>
				<p class="muted">{ fmt.Sprintf("%d titles", total) }</p>
			</div>
		</header>
		<form class="toolbar" method="get" action="/books" hx-get="/books" hx-target="#book-grid" hx-trigger="keyup changed delay:300ms from:input[name=q], change from:select" hx-push-url="true">
			<input class="input" type="search" name="q" value={ q } placeholder="Search titles, series…"/>
			<select class="select" name="format">
				<option value="">All formats</option>
				for _, f := range []string{"epub", "pdf", "cbz", "mp3", "m4b", "m4a", "opus"} {
					<option value={ f } selected?={ format == f }>{ strings.ToUpper(f) }</option>
				}
			</select>
			<select class="select" name="library">
				<option value="">All libraries</option>
				for _, l := range libs {
					<option value={ fmt.Sprintf("%d", l.ID) } selected?={ libID == l.ID }>{ l.Name }</option>
				}
			</select>
			<button class="btn btn-primary" type="submit">Search</button>
		</form>
		<div id="book-grid">
			@BookGrid(books)
		</div>
		if pages > 1 {
			<div class="pagination">
				if page > 1 {
					<a class="btn btn-ghost" href={ fmt.Sprintf("/books?q=%s&format=%s&library=%d&page=%d", q, format, libID, page-1) }>Previous</a>
				}
				<span class="muted">Page { fmt.Sprintf("%d / %d", page, pages) }</span>
				if page < pages {
					<a class="btn btn-ghost" href={ fmt.Sprintf("/books?q=%s&format=%s&library=%d&page=%d", q, format, libID, page+1) }>Next</a>
				}
			</div>
		}
	</div>
}

templ BookGrid(books []models.Book) {
	if len(books) == 0 {
		<div class="empty card"><p>No books match.</p></div>
	} else {
		<div class="book-grid">
			for _, b := range books {
				<a class="book-card" href={ fmt.Sprintf("/books/%d", b.ID) }>
					<div class="cover">
						<img src={ fmt.Sprintf("/covers/%d", b.ID) } alt="" loading="lazy"/>
						<span class="format-pill">{ strings.ToUpper(b.Format) }</span>
					</div>
					<div class="book-meta">
						<div class="book-title">{ b.Metadata.DisplayTitle(b.FileName) }</div>
						if len(b.Authors) > 0 {
							<div class="book-authors muted">{ strings.Join(b.Authors, ", ") }</div>
						}
					</div>
				</a>
			}
		</div>
	}
}

templ BookDetailPage(book models.Book, prog *models.Progress, shelves []models.Shelf, user *models.User, annotationCount int) {
	<div class="page">
		<div class="detail-layout">
			<div class="detail-cover card">
				<img src={ fmt.Sprintf("/covers/%d", book.ID) } alt=""/>
				<div class="detail-actions">
					<a class="btn btn-primary" href={ fmt.Sprintf("/read/%d", book.ID) }>
						if book.Format == "mp3" || book.Format == "m4b" || book.Format == "m4a" || book.Format == "opus" {
							Listen
						} else {
							Read
						}
					</a>
					if user != nil && (user.IsAdmin || user.Permissions.CanDownload) {
						<a class="btn btn-ghost" href={ fmt.Sprintf("/books/%d/download", book.ID) }>Download</a>
					}
					if user != nil && (user.IsAdmin || user.Permissions.CanEditMetadata) {
						<a class="btn btn-ghost" href={ fmt.Sprintf("/books/%d/edit", book.ID) }>Edit metadata</a>
					}
					if annotationCount > 0 {
						<a class="btn btn-ghost" href={ fmt.Sprintf("/annotations?book=%d", book.ID) }>{ fmt.Sprintf("%d annotations", annotationCount) }</a>
						<a class="btn btn-ghost" href={ fmt.Sprintf("/books/%d/annotations/export", book.ID) }>Export annotations</a>
					}
				</div>
			</div>
			<div class="detail-body">
				<p class="eyebrow">{ strings.ToUpper(book.Format) } · { book.LibraryName }</p>
				<h1>{ book.Metadata.DisplayTitle(book.FileName) }</h1>
				if len(book.Authors) > 0 {
					<p class="authors">{ strings.Join(book.Authors, ", ") }</p>
				}
				if prog != nil && prog.Percent > 0 {
					<div class="progress-wrap">
						<div class="progress-bar"><div class="progress-fill" style={ fmt.Sprintf("width:%.1f%%", prog.Percent) }></div></div>
						<span class="muted">{ fmt.Sprintf("%.0f%% · %s", prog.Percent, prog.Status) }</span>
					</div>
				}
				if annotationCount == 0 {
					<p class="muted">No annotations yet. Highlight text or pin a location while reading.</p>
				}
				if book.Metadata.Description != nil && *book.Metadata.Description != "" {
					<section class="section">
						<h2>Description</h2>
						<p class="prose">{ *book.Metadata.Description }</p>
					</section>
				}
				<section class="section meta-grid">
					if book.Metadata.SeriesName != nil && *book.Metadata.SeriesName != "" {
						<div><span class="muted">Series</span><div>{ *book.Metadata.SeriesName }</div></div>
					}
					if book.Metadata.Publisher != nil && *book.Metadata.Publisher != "" {
						<div><span class="muted">Publisher</span><div>{ *book.Metadata.Publisher }</div></div>
					}
					if book.Metadata.ISBN13 != nil && *book.Metadata.ISBN13 != "" {
						<div><span class="muted">ISBN-13</span><div>{ *book.Metadata.ISBN13 }</div></div>
					}
					if len(book.Categories) > 0 {
						<div><span class="muted">Categories</span><div>{ strings.Join(book.Categories, ", ") }</div></div>
					}
				</section>
				if len(shelves) > 0 {
					<section class="section">
						<h2>Add to shelf</h2>
						<div class="chip-row">
							for _, sh := range shelves {
								<form method="post" action={ fmt.Sprintf("/shelves/%d/books/%d", sh.ID, book.ID) }>
									<button class="btn btn-ghost btn-sm" type="submit">{ sh.Name }</button>
								</form>
							}
						</div>
					</section>
				}
				if user != nil && (user.IsAdmin || user.Permissions.CanEditMetadata) {
					<section class="section">
						<h2>Metadata lookup</h2>
						<button class="btn btn-secondary" type="button" hx-post={ fmt.Sprintf("/books/%d/lookup", book.ID) } hx-target="#lookup-results">Search providers</button>
						<div id="lookup-results"></div>
					</section>
				}
			</div>
		</div>
	</div>
}

templ BookEditPage(book models.Book, errMsg string) {
	<div class="page">
		<header class="page-header"><h1>Edit metadata</h1></header>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<form method="post" action={ fmt.Sprintf("/books/%d/edit", book.ID) } class="form-stack card form-card">
			<label>Title<input class="input" name="title" value={ strPtr(book.Metadata.Title, book.FileName) }/></label>
			<label>Subtitle<input class="input" name="subtitle" value={ strPtr(book.Metadata.Subtitle, "") }/></label>
			<label>Authors (comma separated)<input class="input" name="authors" value={ strings.Join(book.Authors, ", ") }/></label>
			<label>Series<input class="input" name="series" value={ strPtr(book.Metadata.SeriesName, "") }/></label>
			<label>Publisher<input class="input" name="publisher" value={ strPtr(book.Metadata.Publisher, "") }/></label>
			<label>ISBN-13<input class="input" name="isbn13" value={ strPtr(book.Metadata.ISBN13, "") }/></label>
			<label>Categories (comma separated)<input class="input" name="categories" value={ strings.Join(book.Categories, ", ") }/></label>
			<label>Description<textarea class="textarea" name="description" rows="8">{ strPtr(book.Metadata.Description, "") }</textarea></label>
			<div class="form-actions">
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-ghost" href={ fmt.Sprintf("/books/%d", book.ID) }>Cancel</a>
			</div>
		</form>
	</div>
}

func strPtr(p *string, fallback string) string {
	if p != nil {
		return *p
	}
	return fallback
}

templ LookupResults(bookID int64, results []metadata.LookupResult) {
	if len(results) == 0 {
		<p class="muted">No results found.</p>
	} else {
		<div class="lookup-list">
			for _, r := range results {
				<div class="lookup-item card">
					<div>
						<strong>{ r.Title }</strong>
						<div class="muted">{ r.Source } · { strings.Join(r.Authors, ", ") }</div>
						if r.Publisher != "" {
							<div class="muted">{ r.Publisher }</div>
						}
					</div>
					<form method="post" action={ fmt.Sprintf("/books/%d/apply-lookup", bookID) }>
						<input type="hidden" name="payload" value={ lookupJSON(r) }/>
						<button class="btn btn-sm btn-primary" type="submit">Apply</button>
					</form>
				</div>
			}
		</div>
	}
}

func lookupJSON(r metadata.LookupResult) string {
	b, _ := json.Marshal(r)
	return string(b)
}

func progressJSON(p *models.Progress) string {
	if p == nil {
		return `{"percent":0,"position":{},"status":"unread"}`
	}
	b, _ := json.Marshal(map[string]any{
		"percent": p.Percent,
		"position": json.RawMessage(p.Position),
		"status": p.Status,
	})
	return string(b)
}

func annotationsExportHref(f models.AnnotationFilter) string {
	parts := []string{}
	if f.BookID > 0 {
		parts = append(parts, fmt.Sprintf("book=%d", f.BookID))
	}
	if f.LibraryID > 0 {
		parts = append(parts, fmt.Sprintf("library=%d", f.LibraryID))
	}
	if f.Format != "" {
		parts = append(parts, "format="+f.Format)
	}
	if f.Kind != "" {
		parts = append(parts, "kind="+f.Kind)
	}
	if f.Color != "" {
		parts = append(parts, "color="+f.Color)
	}
	if f.Tag != "" {
		parts = append(parts, "tag="+f.Tag)
	}
	if f.Query != "" {
		parts = append(parts, "q="+f.Query)
	}
	if len(parts) == 0 {
		return "/annotations/export"
	}
	return "/annotations/export?" + strings.Join(parts, "&")
}

templ LibrariesPage(libs []models.Library, booksDir, errMsg string) {
	<div class="page">
		<header class="page-header">
			<div>
				<h1>Libraries</h1>
				<p class="muted">Paths are relative to { booksDir } or absolute.</p>
			</div>
		</header>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<div class="two-col">
			<section class="card form-card">
				<h2>New library</h2>
				<form method="post" action="/libraries" class="form-stack">
					<label>Name<input class="input" name="name" required/></label>
					<label>Path<input class="input" name="path" placeholder="fiction" required/></label>
					<label>Icon<input class="input" name="icon" value="book"/></label>
					<label class="check"><input type="checkbox" name="watch"/> Watch for new files</label>
					<button class="btn btn-primary" type="submit">Create</button>
				</form>
			</section>
			<section class="list-stack">
				for _, l := range libs {
					<div class="card lib-card">
						<div>
							<h3>{ l.Name }</h3>
							<p class="muted">{ fmt.Sprintf("%d books", l.BookCount) }</p>
							for _, p := range l.Paths {
								<code class="path">{ p.Path }</code>
							}
						</div>
						<div class="chip-row">
							<form method="post" action={ fmt.Sprintf("/libraries/%d/scan", l.ID) }>
								<button class="btn btn-primary btn-sm" type="submit">Scan</button>
							</form>
							<form method="post" action={ fmt.Sprintf("/libraries/%d/delete", l.ID) } onsubmit="return confirm('Delete library?')">
								<button class="btn btn-ghost btn-sm" type="submit">Delete</button>
							</form>
							<a class="btn btn-ghost btn-sm" href={ fmt.Sprintf("/books?library=%d", l.ID) }>Browse</a>
						</div>
					</div>
				}
			</section>
		</div>
		<section class="card form-card section">
			<h2>Upload a book</h2>
			<form method="post" action="/upload" enctype="multipart/form-data" class="form-stack">
				<label>Library
					<select class="select" name="library_id" required>
						for _, l := range libs {
							<option value={ fmt.Sprintf("%d", l.ID) }>{ l.Name }</option>
						}
					</select>
				</label>
				<label>File<input class="input" type="file" name="file" required/></label>
				<button class="btn btn-secondary" type="submit">Upload</button>
			</form>
		</section>
	</div>
}

templ ShelvesPage(shelves []models.Shelf, errMsg string) {
	<div class="page">
		<header class="page-header"><h1>Shelves</h1></header>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<div class="two-col">
			<form method="post" action="/shelves" class="card form-card form-stack">
				<h2>New shelf</h2>
				<label>Name<input class="input" name="name" required/></label>
				<label>Icon<input class="input" name="icon" value="bookmark"/></label>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
			<div class="list-stack">
				for _, sh := range shelves {
					<div class="card lib-card">
						<div>
							<a href={ fmt.Sprintf("/shelves/%d", sh.ID) }><h3>{ sh.Name }</h3></a>
							<p class="muted">{ fmt.Sprintf("%d books", sh.BookCount) }</p>
						</div>
						<form method="post" action={ fmt.Sprintf("/shelves/%d/delete", sh.ID) }>
							<button class="btn btn-ghost btn-sm" type="submit">Delete</button>
						</form>
					</div>
				}
			</div>
		</div>
	</div>
}

templ ShelfDetailPage(id int64, books []models.Book) {
	<div class="page">
		<header class="page-header">
			<div>
				<a class="muted" href="/shelves">← Shelves</a>
				<h1>Shelf</h1>
			</div>
		</header>
		@BookGrid(books)
	</div>
}

templ MagicShelvesPage(list []models.MagicShelf, errMsg string) {
	<div class="page">
		<header class="page-header">
			<div>
				<h1>Magic shelves</h1>
				<p class="muted">Dynamic collections based on rules.</p>
			</div>
		</header>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<div class="two-col">
			<form method="post" action="/magic-shelves" class="card form-card form-stack">
				<h2>New magic shelf</h2>
				<label>Name<input class="input" name="name" required/></label>
				<label>Author contains<input class="input" name="author"/></label>
				<label>Category contains<input class="input" name="category"/></label>
				<label>Series contains<input class="input" name="series"/></label>
				<label>Format
					<select class="select" name="format">
						<option value="">Any</option>
						for _, f := range []string{"epub", "pdf", "cbz", "mp3", "m4b"} {
							<option value={ f }>{ f }</option>
						}
					</select>
				</label>
				<label>Read status
					<select class="select" name="status">
						<option value="">Any</option>
						<option value="unread">unread</option>
						<option value="reading">reading</option>
						<option value="finished">finished</option>
					</select>
				</label>
				<label>Search query<input class="input" name="query"/></label>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
			<div class="list-stack">
				for _, ms := range list {
					<div class="card lib-card">
						<div>
							<a href={ fmt.Sprintf("/magic-shelves/%d", ms.ID) }><h3>{ ms.Name }</h3></a>
							<p class="muted">Rule-based collection</p>
						</div>
						<form method="post" action={ fmt.Sprintf("/magic-shelves/%d/delete", ms.ID) }>
							<button class="btn btn-ghost btn-sm" type="submit">Delete</button>
						</form>
					</div>
				}
			</div>
		</div>
	</div>
}

templ MagicDetailPage(ms models.MagicShelf, books []models.Book) {
	<div class="page">
		<header class="page-header">
			<div>
				<a class="muted" href="/magic-shelves">← Magic shelves</a>
				<h1>{ ms.Name }</h1>
			</div>
		</header>
		@BookGrid(books)
	</div>
}

templ BookdropPage(files []models.BookdropFile, libs []models.Library) {
	<div class="page">
		<header class="page-header">
			<div>
				<h1>BookDrop</h1>
				<p class="muted">Drop files into the bookdrop folder for review and import.</p>
			</div>
		</header>
		if len(files) == 0 {
			<div class="empty card"><p>Nothing waiting. Drop EPUB, PDF, CBZ, or audio into the BookDrop directory.</p></div>
		} else {
			<div class="list-stack">
				for _, f := range files {
					<div class="card lib-card">
						<div>
							<strong>{ f.FileName }</strong>
							if f.Title != "" {
								<div>{ f.Title }</div>
							}
							if f.Authors != "" {
								<div class="muted">{ f.Authors }</div>
							}
							<span class={ "badge status-" + f.Status }>{ f.Status }</span>
						</div>
						if f.Status == "ready" {
							<form method="post" action={ fmt.Sprintf("/bookdrop/%d/import", f.ID) } class="chip-row">
								<select class="select" name="library_id" required>
									for _, l := range libs {
										<option value={ fmt.Sprintf("%d", l.ID) }>{ l.Name }</option>
									}
								</select>
								<button class="btn btn-primary btn-sm" type="submit">Import</button>
							</form>
						}
						<form method="post" action={ fmt.Sprintf("/bookdrop/%d/reject", f.ID) }>
							<button class="btn btn-ghost btn-sm" type="submit">Reject</button>
						</form>
					</div>
				}
			</div>
		}
	</div>
}

templ ReaderPage(book models.Book, prog *models.Progress) {
	<div class="reader-page" data-book-id={ fmt.Sprintf("%d", book.ID) } data-format={ book.Format }>
		<header class="reader-bar">
			<a class="btn btn-ghost btn-sm" href={ fmt.Sprintf("/books/%d", book.ID) }>← Back</a>
			<div class="reader-title">{ book.Metadata.DisplayTitle(book.FileName) }</div>
			<div id="reader-status" class="muted"></div>
			<button type="button" class="btn btn-ghost btn-sm" id="ann-pin-btn" title="Pin current location (b)">Pin</button>
			<button type="button" class="btn btn-primary btn-sm" id="ann-panel-toggle" title="Annotations (a)">Annotations</button>
		</header>
		<div class="reader-body">
			<div class="reader-main">
				if book.Format == "epub" {
					<div id="epub-viewer" class="reader-stage"></div>
					<script src="/static/vendor/jszip.min.js"></script>
					<script src="/static/vendor/epub.min.js"></script>
					<script src="/static/js/readers/annotations.js"></script>
					<script src="/static/js/readers/epub.js"></script>
				} else if book.Format == "pdf" {
					<div id="pdf-viewer" class="reader-stage pdf-stage">
						<div class="pdf-toolbar">
							<button type="button" class="btn btn-ghost btn-sm" id="pdf-prev">Prev</button>
							<span id="pdf-page-label" class="muted">Page 1</span>
							<button type="button" class="btn btn-ghost btn-sm" id="pdf-next">Next</button>
						</div>
						<div id="pdf-canvas-wrap">
							<canvas id="pdf-canvas"></canvas>
							<div id="pdf-text-layer" class="pdf-text-layer"></div>
							<div id="pdf-hl-layer" class="pdf-hl-layer"></div>
						</div>
					</div>
					<script src="/static/vendor/pdf.min.js"></script>
					<script src="/static/js/readers/annotations.js"></script>
					<script src="/static/js/readers/pdf.js"></script>
				} else if book.Format == "cbz" {
					<div id="cbz-viewer" class="reader-stage">
						<button id="cbz-prev" class="btn btn-ghost" type="button">Prev</button>
						<img id="cbz-page" alt="page"/>
						<button id="cbz-next" class="btn btn-ghost" type="button">Next</button>
					</div>
					<script src="/static/js/readers/annotations.js"></script>
					<script src="/static/js/readers/cbz.js"></script>
				} else {
					<div id="audio-viewer" class="reader-stage audio-stage card">
						<img class="audio-cover" src={ fmt.Sprintf("/covers/%d", book.ID) } alt=""/>
						<audio id="audio-player" controls src={ fmt.Sprintf("/stream/%d", book.ID) }></audio>
					</div>
					<script src="/static/js/readers/annotations.js"></script>
					<script src="/static/js/readers/audio.js"></script>
				}
			</div>
			<aside class="ann-panel" id="ann-panel" hidden>
				<div class="ann-panel-head">
					<strong>Annotations</strong>
					<button type="button" class="btn btn-ghost btn-sm" id="ann-panel-close">Close</button>
				</div>
				<div class="ann-filters" id="ann-filters">
					<button type="button" class="chip active" data-kind="">All</button>
					<button type="button" class="chip" data-kind="highlight">Highlights</button>
					<button type="button" class="chip" data-kind="bookmark">Pins</button>
					<button type="button" class="chip" data-kind="note">Notes</button>
				</div>
				<div class="ann-list" id="ann-list"></div>
				<div class="ann-panel-foot">
					<a class="btn btn-ghost btn-sm" href={ fmt.Sprintf("/books/%d/annotations/export", book.ID) }>Export MD</a>
					<button type="button" class="btn btn-ghost btn-sm" id="ann-help-btn">Shortcuts</button>
				</div>
			</aside>
		</div>
		<div id="ann-toolbar" class="ann-toolbar" hidden>
			<span class="ann-palette" id="ann-palette">
				<button type="button" class="ann-swatch" data-color="yellow" title="yellow" style="--sw:var(--color-warning)"></button>
				<button type="button" class="ann-swatch" data-color="green" title="green" style="--sw:var(--color-success)"></button>
				<button type="button" class="ann-swatch" data-color="blue" title="blue" style="--sw:var(--color-info)"></button>
				<button type="button" class="ann-swatch" data-color="pink" title="pink" style="--sw:var(--color-secondary)"></button>
				<button type="button" class="ann-swatch" data-color="purple" title="purple" style="--sw:var(--color-primary)"></button>
			</span>
			<button type="button" class="btn btn-sm" id="ann-add-note">Note</button>
			<button type="button" class="btn btn-sm" id="ann-add-pin">Pin</button>
		</div>
		<dialog id="ann-edit-dialog" class="ann-dialog">
			<form method="dialog" id="ann-edit-form" class="form-stack">
				<h3 id="ann-edit-title">Annotation</h3>
				<p class="muted" id="ann-edit-quote"></p>
				<label>Note<textarea class="textarea" id="ann-edit-note" rows="3" maxlength="10000"></textarea></label>
				<label>Tags <span class="muted">(comma-separated)</span><input class="input" id="ann-edit-tags" maxlength="400"/></label>
				<label>Color
					<select class="select" id="ann-edit-color">
						<option value="">None</option>
						<option value="yellow">Yellow</option>
						<option value="green">Green</option>
						<option value="blue">Blue</option>
						<option value="pink">Pink</option>
						<option value="purple">Purple</option>
					</select>
				</label>
				<div class="form-actions">
					<button type="submit" class="btn btn-primary" value="save">Save</button>
					<button type="button" class="btn btn-ghost" id="ann-edit-delete">Delete</button>
					<button type="submit" class="btn btn-ghost" value="cancel">Cancel</button>
				</div>
			</form>
		</dialog>
		<script type="application/json" id="progress-data">{ progressJSON(prog) }</script>
	</div>
}

templ AnnotationsPage(list []models.Annotation, total int, f models.AnnotationFilter, libs []models.Library) {
	<div class="page">
		<header class="page-header">
			<div>
				<h1>Annotations</h1>
				<p class="muted">{ fmt.Sprintf("%d total", total) }</p>
			</div>
			<a class="btn btn-secondary" href={ annotationsExportHref(f) }>Export Markdown</a>
		</header>
		<form method="get" action="/annotations" class="card form-card filter-bar form-stack">
			<div class="filter-row">
				<label>Search<input class="input" type="search" name="q" value={ f.Query } placeholder="Quotes, notes, tags"/></label>
				<label>Kind
					<select class="select" name="kind">
						<option value="">All</option>
						<option value="highlight" selected?={ f.Kind == "highlight" }>Highlight</option>
						<option value="bookmark" selected?={ f.Kind == "bookmark" }>Bookmark</option>
						<option value="note" selected?={ f.Kind == "note" }>Note</option>
					</select>
				</label>
				<label>Color
					<select class="select" name="color">
						<option value="">All</option>
						for _, c := range []string{"yellow", "green", "blue", "pink", "purple"} {
							<option value={ c } selected?={ f.Color == c }>{ c }</option>
						}
					</select>
				</label>
				<label>Format
					<select class="select" name="format">
						<option value="">All</option>
						for _, fmtName := range []string{"epub", "pdf", "cbz", "mp3", "m4b", "m4a", "opus"} {
							<option value={ fmtName } selected?={ f.Format == fmtName }>{ fmtName }</option>
						}
					</select>
				</label>
				<label>Library
					<select class="select" name="library">
						<option value="">All</option>
						for _, lib := range libs {
							<option value={ fmt.Sprintf("%d", lib.ID) } selected?={ f.LibraryID == lib.ID }>{ lib.Name }</option>
						}
					</select>
				</label>
				if f.BookID > 0 {
					<input type="hidden" name="book" value={ fmt.Sprintf("%d", f.BookID) }/>
				}
			</div>
			<div class="form-actions">
				<button class="btn btn-primary" type="submit">Filter</button>
				<a class="btn btn-ghost" href="/annotations">Clear</a>
			</div>
		</form>
		if len(list) == 0 {
			<div class="empty card">
				<p>No annotations yet.</p>
				<p class="muted">Open a book, select text to highlight, or press <kbd>b</kbd> to pin a location.</p>
			</div>
		} else {
			<div class="list-stack ann-global-list">
				for _, ann := range list {
					<article class="card ann-global-item">
						<div class="ann-global-meta">
							<a href={ fmt.Sprintf("/books/%d", ann.BookID) } class="ann-book-title">{ ann.BookTitle }</a>
							<span class={ "ann-kind-badge ann-kind-" + ann.Kind }>{ ann.Kind }</span>
							if ann.Color != nil && *ann.Color != "" {
								<span class={ "ann-color-dot ann-color-" + *ann.Color } title={ *ann.Color }></span>
							}
							<span class="muted">{ ann.CreatedAt.Format("2006-01-02") }</span>
						</div>
						if ann.Quote != "" {
							<blockquote class="ann-quote">{ ann.Quote }</blockquote>
						}
						if ann.Note != "" {
							<p class="ann-note-body">{ ann.Note }</p>
						}
						if len(ann.Tags) > 0 {
							<div class="chip-row">
								for _, t := range ann.Tags {
									<span class="chip">{ t }</span>
								}
							</div>
						}
						<div class="form-actions">
							<a class="btn btn-primary btn-sm" href={ fmt.Sprintf("/read/%d?annotation=%d", ann.BookID, ann.ID) }>Open</a>
						</div>
					</article>
				}
			</div>
			if total > 50 {
				<div class="pagination">
					<p class="muted">Showing { fmt.Sprintf("%d", len(list)) } of { fmt.Sprintf("%d", total) }. Refine filters or export for the full set.</p>
				</div>
			}
		}
	</div>
}

templ SettingsPage(me *models.User, users []models.User, opds []models.OPDSUser, libs []models.Library, themes []string, currentTheme, errMsg string) {
	<div class="page">
		<header class="page-header"><h1>Settings</h1></header>
		if errMsg != "" {
			<div class="alert alert-error">{ errMsg }</div>
		}
		<section class="card form-card section">
			<h2>Theme</h2>
			<form method="post" action="/settings/theme" class="form-stack">
				<label>Appearance
					<select class="select" name="theme" onchange="document.documentElement.setAttribute('data-theme', this.value)">
						for _, t := range themes {
							<option value={ t } selected?={ t == currentTheme }>{ t }</option>
						}
					</select>
				</label>
				<button class="btn btn-primary" type="submit">Save theme</button>
			</form>
		</section>
		if me != nil && me.IsAdmin {
			<section class="card form-card section">
				<h2>Users</h2>
				<div class="list-stack">
					for _, u := range users {
						<div class="lib-card">
							<div>
								<strong>{ u.Username }</strong>
								if u.IsAdmin {
									<span class="badge">admin</span>
								}
							</div>
							<form method="post" action={ fmt.Sprintf("/settings/users/%d/perms", u.ID) } class="perm-grid">
								<label class="check"><input type="checkbox" name="is_admin" checked?={ u.IsAdmin }/> Admin</label>
								<label class="check"><input type="checkbox" name="can_upload" checked?={ u.Permissions.CanUpload }/> Upload</label>
								<label class="check"><input type="checkbox" name="can_download" checked?={ u.Permissions.CanDownload }/> Download</label>
								<label class="check"><input type="checkbox" name="can_edit_metadata" checked?={ u.Permissions.CanEditMetadata }/> Edit metadata</label>
								<label class="check"><input type="checkbox" name="can_manage_library" checked?={ u.Permissions.CanManageLibrary }/> Manage library</label>
								<button class="btn btn-sm btn-secondary" type="submit">Update</button>
							</form>
						</div>
					}
				</div>
				<form method="post" action="/settings/users" class="form-stack" style="margin-top:1rem">
					<h3>Add user</h3>
					<label>Username<input class="input" name="username" required/></label>
					<label>Display name<input class="input" name="display_name"/></label>
					<label>Password<input class="input" type="password" name="password" required minlength="8"/></label>
					<label class="check"><input type="checkbox" name="can_download" checked/> Download</label>
					<label class="check"><input type="checkbox" name="can_upload"/> Upload</label>
					<label class="check"><input type="checkbox" name="can_edit_metadata"/> Edit metadata</label>
					<label class="check"><input type="checkbox" name="can_manage_library"/> Manage library</label>
					<label class="check"><input type="checkbox" name="is_admin"/> Admin</label>
					<button class="btn btn-primary" type="submit">Create user</button>
				</form>
			</section>
			<section class="card form-card section">
				<h2>OPDS</h2>
				<p class="muted">Basic-auth credentials for OPDS clients. Catalog: /opds</p>
				for _, o := range opds {
					<div class="lib-card">
						<code>{ o.Username }</code>
						<form method="post" action={ fmt.Sprintf("/settings/opds/%d/delete", o.ID) }>
							<button class="btn btn-ghost btn-sm" type="submit">Delete</button>
						</form>
					</div>
				}
				<form method="post" action="/settings/opds" class="form-stack">
					<label>Username<input class="input" name="username" required/></label>
					<label>Password<input class="input" type="password" name="password" required/></label>
					<button class="btn btn-secondary" type="submit">Create OPDS user</button>
				</form>
			</section>
		}
	</div>
}
